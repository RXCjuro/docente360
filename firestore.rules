rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Verificar que el usuario tenga un perfil autorizado
    function autorizado() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.email == request.auth.token.email
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['admin', 'editor', 'consulta'];
    }

    // Obtener el rol del usuario
    function rol() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol;
    }

    // Verificar si es administrador
    function esAdmin() {
      return autorizado() && rol() == 'admin';
    }

    // Verificar si puede crear y editar
    function puedeEditar() {
      return autorizado() && rol() in ['admin', 'editor'];
    }

    // Colección de usuarios y roles
    match /usuarios/{uid} {

      // Cada usuario puede consultar su perfil.
      // El administrador puede consultar todos los perfiles.
      allow read: if autorizado()
        && (request.auth.uid == uid || esAdmin());

      // Los perfiles se crean manualmente desde Firebase Console
      allow create: if false;

      // Solo el administrador puede actualizar perfiles
      allow update: if esAdmin();

      // No se permite eliminar perfiles desde la aplicación
      allow delete: if false;
    }

    // Colecciones principales de Docente360
    match /{col}/{id} {

      // Todos los usuarios autorizados pueden consultar
      allow read: if autorizado()
        && col in [
          'docentes',
          'evaluaciones',
          'supervisiones',
          'encuestas'
        ];

      // Administradores y editores pueden crear y editar
      allow create, update: if puedeEditar()
        && col in [
          'docentes',
          'evaluaciones',
          'supervisiones',
          'encuestas'
        ];

      // Solo el administrador puede eliminar
      allow delete: if esAdmin()
        && col in [
          'docentes',
          'evaluaciones',
          'supervisiones',
          'encuestas'
        ];
    }
  }
}
